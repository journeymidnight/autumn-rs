# Build output
/target

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local test artefacts (cluster.sh, perf_check.sh)
/tmp/
/dev/shm/

# Python bindings build output
python/target
python/*.so

# Python packaging metadata (pip install -e leftovers, __pycache__)
python/**/*.egg-info/
python/**/__pycache__/
python/**/*.pyc

# Ignore all perf_baseline*.json — users regenerate these locally via
# `perf_check.sh --update-baseline`. ONE representative baseline is
# committed (perf_baseline_tcp_p16_d8_s4k.json, the headline TCP 4 K
# 3-disk run at t=256 p=16) as a reference; everything else is local
# scratch.
perf_baseline*.json
!perf_baseline_tcp_p16_d8_s4k.json

# Claude Code local session state (not part of the project)
.claude/

# Tooling caches / generated lockfiles for nested crates
.codex
/python/Cargo.lock
