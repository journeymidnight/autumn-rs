# Build output
/target

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local test artefacts (cluster.sh, perf_check.sh)
/tmp/
/dev/shm/

# Python bindings build output
python/target
python/*.so

# Python packaging metadata (pip install -e leftovers, __pycache__)
python/**/*.egg-info/
python/**/__pycache__/
python/**/*.pyc
python/**/.pytest_cache/

# Ignore all perf_baseline*.json by default (users regenerate locally via
# `perf-check --update-baseline`). Committed exception: the KEY matched
# TCP+UCX matrix at the canonical config (p8 d8 t16, 4K + 8M) — the
# reference for tcp-vs-ucx regression tracking. Everything else (_shm,
# p16/p32, other sizes) stays local scratch.
perf_baseline*.json
!perf_baseline_tcp_p8_d8_s4k.json
!perf_baseline_tcp_p8_d8_s8m.json
!perf_baseline_ucx_p8_d8_s4k.json
!perf_baseline_ucx_p8_d8_s8m.json

# Claude Code local session state (not part of the project)
.claude/

# Tooling caches / generated lockfiles for nested crates
.codex
# python/Cargo.lock IS committed and pinned: the `autumn` PyO3 client links the
# same wire crates as the core, so its rkyv family MUST match the core's root
# Cargo.lock or the vllm/hermes native client silently drifts to a different
# rkyv patch (0.8.17 vs core's 0.8.15) → same wire fingerprint, incompatible
# bytes → `rkyv decode: failed` on EN-direct reads. Keep them in lockstep.
.skillopt-sleep/
