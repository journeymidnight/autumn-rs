# Build output
/target

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Local test artefacts (scripts/cluster.sh, perf_check.sh)
/tmp/
/dev/shm/

# Python bindings build output
python/target
python/*.so

# Python packaging metadata (pip install -e leftovers, __pycache__)
python/**/*.egg-info/
python/**/__pycache__/
python/**/*.pyc
python/**/.pytest_cache/

# perf-check baselines are per machine: perf_check.sh writes one with
# --update-baseline and compares against it on later runs.
perf_baseline*.json

# Claude Code local session state (not part of the project)
.claude/

# Tooling caches / generated lockfiles for nested crates
.codex
# python/Cargo.lock IS committed and pinned: the `autumn` PyO3 client links the
# same wire crates as the core, so its rkyv family MUST match the core's root
# Cargo.lock or downstream native clients silently drift to a different
# rkyv patch (0.8.17 vs core's 0.8.15) → same wire fingerprint, incompatible
# bytes → `rkyv decode: failed` on EN-direct reads. Keep them in lockstep.
.skillopt-sleep/

# Local tool state
.omo/
.codegraph
.playwright-cli/

# Maintainer-local notes, kept out of the repo. Anchored so crates/*/CLAUDE.md stay tracked.
/CLAUDE.md
/claude-progress.txt
/feature_list.md
